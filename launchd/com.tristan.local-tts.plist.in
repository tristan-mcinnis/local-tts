<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Local TTS service. Rendered by scripts/install-runtime.sh, which replaces
     @HOME@ with your home directory. It runs the installed copy in
     ~/.local/libexec/local-tts, never the repo, because launchd may be refused
     ~/Documents. Change the port or paths here. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.tristan.local-tts</string>
	<key>ProgramArguments</key>
	<array>
		<string>@HOME@/.local/libexec/local-tts/pocket-tts</string>
		<string>--server</string>
		<string>--port</string>
		<string>8081</string>
		<string>--models-dir</string>
		<string>@HOME@/Models/pocket-tts</string>
		<string>--voices-dir</string>
		<string>@HOME@/Models/pocket-tts/voices</string>
		<string>--tokenizer</string>
		<string>@HOME@/Models/pocket-tts/tokenizer.model</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/local-tts.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/local-tts.err.log</string>
</dict>
</plist>
