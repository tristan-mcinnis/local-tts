# Build artifacts
.build/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Compiled binaries
pocket-tts
*.so
*.so.*
*.dylib
*.dll
*.lib
*.exe
# License texts the build copies next to libonnxruntime
/third_party_licenses/

# Model bundle lives in the shared store (~/Models/pocket-tts); models/ is a
# machine-local symlink there. Regenerate with tools/prepare_models.sh.
# Weights are never committed; the symlink itself is ignored too.
/models

# Voice samples (except the shipped example)
voices/*

# Voice embedding cache
.cache/

# Python virtual environment
.venv/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Generated ONNX model sets (regenerate via export_onnx.py + make_*.py)
onnx/
webdemo/models/*.onnx
webdemo/models/*.onnx.br
webdemo/models/tokenizer.model*

# Generated benchmark/test audio
results/

# Python bytecode
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Dev-server self-signed certificate (private key!)
webdemo/.certs/

# WASM build tree (artifacts land in webdemo/vendor/ptt)
webdemo/wasm/build/
webdemo/vendor/ptt/*relaxed*

# Optional local AudioMass checkout/build. Keep only the integration README.
webdemo/audiomass/*
!webdemo/audiomass/README.md

# Brotli pre-compressed assets (regenerate via webdemo/compress.py)
webdemo/**/*.br
webdemo/wasm/build-relaxed/

# ship one sample voice so examples work out of the box
!voices/example.wav

# Generated webdemo test fixtures (npm run fixtures)
webdemo/test/xfer_states.bin
webdemo/test/ref_latents.f32
webdemo/test/ref_audio.f32

# Machine-local agent hooks and design-lint ratchet (reach into a sibling
# design-system checkout; not part of the public repo)
/.claude/
/.design-lint-baseline.json
